# ==============================================================================
# BEFORE HARDENING (Vulnerable Reference for Question 2c)
# ==============================================================================
# 1. Heavy base image based on full Debian Linux (~1.1 GB in size)
# Contains hundreds of unneeded OS packages (curl, perl, bash, etc.)
FROM node:20

# 2. Set working directory
WORKDIR /app

# 3. Copy dependencies and application files
COPY package*.json ./
RUN npm install

COPY . .

# 4. SECURITY FLAW: Runs as default root user (UID 0)
# Any process vulnerability gives the attacker full root access to the container!
USER root

ENV PORT=5001
EXPOSE 5001

CMD ["node", "index.js"]
